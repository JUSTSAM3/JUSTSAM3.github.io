---
export const getStaticPaths = () => {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
  ];
};

import { getCollection } from "astro:content";
import Layout from "@/src/layouts/Layout.astro";
import { useI18n } from "@ariaskit/astro-i18n";
import { type LocaleSchema } from "@/src/types";
import Header from "@/src/components/Header.astro";
import Hero from "@/src/components/Hero.astro";
import Evidences from "@/src/components/Evidences.astro";
import Research from "@/src/components/Research.astro";
import Projects from "@/src/components/Projects.astro";
import Experience from "@/src/components/Experience.astro";
import Footer from "@/src/components/Footer.astro";
import Skills from "@/src/components/Skills.astro";

const { t, locale } = useI18n<LocaleSchema>({
  ssg: {
    astro: Astro,
  },
});

const evidenciasItems = (await getCollection("evidencias"))
  .filter((entry) => entry.data.lang === locale)
  .sort((a, b) => a.data.order - b.data.order);

const investigacionItems = (await getCollection("investigacion"))
  .filter((entry) => entry.data.lang === locale)
  .sort((a, b) => a.data.order - b.data.order);

const nav = [
  { key: "nav.about", path: "", text: t("nav.about") },
  { key: "nav.evidences", path: "#evidences", text: t("nav.evidences") },
  { key: "nav.research", path: "#research", text: t("nav.research") },
  { key: "nav.projects", path: "#projects", text: t("nav.projects") },
  { key: "nav.contact", path: "#contact", text: t("nav.contact") },
];

const heroProps = {
  id: "about",
  name: "SAMUEL MESA",
  title: { key: "hero.title", value: t("hero.title") },
  p1: { key: "hero.p1", value: t("hero.p1") },
  p2: { key: "hero.p2", value: t("hero.p2") },
  p3: { key: "hero.p3", value: t("hero.p3") },
};

const evidenceCategories = [
  { id: "sql-avanzado" as const, label: t("evidences.categories.sql_avanzado") },
  { id: "plsql" as const, label: t("evidences.categories.plsql") },
  { id: "postgresql" as const, label: t("evidences.categories.postgresql") },
  { id: "mongodb" as const, label: t("evidences.categories.mongodb") },
];

const projects = [
  {
    nameKey: "projects.item_1.name",
    descriptionKey: "projects.item_1.description",
    name: t("projects.item_1.name"),
    description: t("projects.item_1.description"),
    link: t("projects.item_1.link"),
  },
  {
    nameKey: "projects.item_2.name",
    descriptionKey: "projects.item_2.description",
    name: t("projects.item_2.name"),
    description: t("projects.item_2.description"),
    link: t("projects.item_2.link"),
  },
  {
    nameKey: "projects.item_3.name",
    descriptionKey: "projects.item_3.description",
    name: t("projects.item_3.name"),
    description: t("projects.item_3.description"),
    link: t("projects.item_3.link"),
  },
];

const projectsProps = {
  id: "projects",
  title: { key: "projects.title", value: t("projects.title") },
  projects,
};

const experienceData = {
  id: "experience",
  title: {
    key: "experience.title",
    value: t("experience.title"),
  },
  jobs: [
    {
      period: {
        key: "experience.item_1.period",
        value: t("experience.item_1.period"),
      },
      role: {
        key: "experience.item_1.role",
        value: t("experience.item_1.role"),
      },
      company: {
        key: "experience.item_1.company",
        value: t("experience.item_1.company"),
      },
      description: {
        key: "experience.item_1.description",
        value: t("experience.item_1.description"),
      },
    },
  ],
};

const alternate = [
  { href: "/es", hreflang: "es" },
  { href: "/en", hreflang: "en" },
];

const footerContent = {
  id: "contact",
  status: {
    key: "contact.status",
    value: t("contact.status"),
  },
  email_label: {
    key: "contact.email_label",
    value: t("contact.email_label"),
  },
  email_url: {
    key: "contact.email_url",
    value: t("contact.email_url"),
  },
  github_label: {
    key: "contact.github_label",
    value: t("contact.github_label"),
  },
  github_url: {
    key: "contact.github_url",
    value: t("contact.github_url"),
  },
  yt_label: {
    key: "contact.yt_label",
    value: t("contact.yt_label"),
  },
  yt_url: {
    key: "contact.yt_url",
    value: t("contact.yt_url"),
  },
};

const skillKeys = ["java", "python", "docker"] as const;
const skills = skillKeys.map((k) => ({
  title: { key: `skills.${k}.title`, value: t(`skills.${k}.title` as any) },
  category: { key: `skills.${k}.category`, value: t(`skills.${k}.category` as any) },
  description: { key: `skills.${k}.description`, value: t(`skills.${k}.description` as any) },
  experience_years: { key: `skills.${k}.experience_years`, value: t(`skills.${k}.experience_years` as any) },
  experience_label: { key: `skills.${k}.experience_label`, value: t(`skills.${k}.experience_label` as any) },
}));
---

<Layout
  locale={locale}
  title={t("meta.title")}
  description={t("description")}
  alternateLinks={alternate}
>
  <Header nav={nav} locales={["en", "es"]} currentLocale={locale} />

  <main>
    <Hero {...heroProps} />
    <Evidences
      id="evidences"
      locale={locale}
      heading={{ key: "evidences.heading", value: t("evidences.heading") }}
      subtitle={{ key: "evidences.subtitle", value: t("evidences.subtitle") }}
      readMoreLabel={t("evidences.read_more")}
      categories={evidenceCategories}
      items={evidenciasItems}
    />
    <Research
      id="research"
      locale={locale}
      heading={{ key: "research.heading", value: t("research.heading") }}
      subtitle={{ key: "research.subtitle", value: t("research.subtitle") }}
      readMoreLabel={t("research.read_more")}
      items={investigacionItems}
    />
    <Projects {...projectsProps} />
    <Experience {...experienceData} />
    <Skills heading={{ key: "skills.heading", value: t("skills.heading") }} content={skills} />
  </main>

  <Footer {...footerContent} />
</Layout>
